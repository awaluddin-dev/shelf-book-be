generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "user"]
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
  @@schema("user")
}

model PortfolioStatus {
  id        String   @id @default("status_1")
  status    String   @default("busy")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("portfolio_status")
  @@schema("public")
}

model HeroConfig {
  id            String   @id @default("hero_1")
  name          String?
  role          String?
  openForWork   Boolean? @default(true)
  expertise     String?
  grit          String?
  service       String?
  config        Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  availableFrom String?

  @@map("hero_config")
  @@schema("public")
}

model Metric {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  value     String
  label     String
  icon      String?
  isSavings Boolean? @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("metrics")
  @@schema("public")
}

model Testimonial {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  name        String
  role        String
  company     String
  url         String?
  testimonial String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("testimonials")
  @@schema("public")
}

model WorkExperience {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  years      String
  duration   String
  company    String
  role       String
  stack      String
  teaser     String
  fullImpact String
  bullets    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("work_experiences")
  @@schema("public")
}

model CurrentFocus {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  title       String
  icon        String
  description String
  link        String?
  linkText    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  roadmapId   String?
  roadmap     Roadmap? @relation(fields: [roadmapId], references: [id])

  @@map("current_focus")
  @@schema("public")
}

model Proficiency {
  id         String             @id @default(dbgenerated("gen_random_uuid()"))
  title      String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @default(now()) @updatedAt
  skills     ProficiencySkill[]
  treeSkills Skill[]

  @@map("proficiencies")
  @@schema("public")
}

model ProficiencySkill {
  id            String      @id @default(dbgenerated("gen_random_uuid()"))
  name          String
  subtext       String
  status        String
  proficiencyId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  proficiency   Proficiency @relation(fields: [proficiencyId], references: [id], onDelete: Cascade)
  treeSkills    Skill[]

  @@map("proficiency_skills")
  @@schema("public")
}

model Skill {
  id                 String            @id @default(dbgenerated("gen_random_uuid()"))
  title              String
  level              String
  details            String
  x                  Int               @default(0)
  y                  Int               @default(0)
  connections        String[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt
  categoryId         String?
  proficiencySkillId String?
  category           Proficiency?      @relation(fields: [categoryId], references: [id])
  proficiencySkill   ProficiencySkill? @relation(fields: [proficiencySkillId], references: [id])

  @@map("skills")
  @@schema("public")
}

model Roadmap {
  id             String         @id @default(dbgenerated("gen_random_uuid()"))
  tech           String
  quarter        String
  status         String
  icon           String?
  description    String
  depth          String?
  topics         String[]
  projects       String[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  currentFocuses CurrentFocus[]

  @@map("roadmaps")
  @@schema("public")
}

model Project {
  id                  String               @id @default(dbgenerated("gen_random_uuid()"))
  title               String
  subtitle            String
  category            String
  date                String
  tags                String[]
  spineColor          String
  coverColor          String
  spineText           String
  github              String?
  demoUrl             String?
  stats               Json?
  phases              Json?
  markdown            String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  problemSolved       String?
  reasonToBuild       String?
  projectLifecycles      ProjectLifecycle[]
  systemArchitectures    SystemArchitecture[]
  technicalImagery       TechnicalImagery?
  projectDatabaseSchemas ProjectDatabaseSchema[]
  projectErds            ProjectErd[]

  @@map("projects")
  @@schema("public")
}

model SystemArchitecture {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  projectId   String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imageUrl    String   @default("")
  description String   @default("")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("system_architectures")
  @@schema("public")
}

model ProjectLifecycle {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  projectId   String
  stage       String
  date        String
  title       String
  description String
  evidentUrl  String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_lifecycles")
  @@schema("public")
}

model TechnicalImagery {
  id               String   @id @default(dbgenerated("gen_random_uuid()"))
  projectId        String   @unique
  featured         String   @default("")
  blueprint        String   @default("")
  metrics          String   @default("")
  featuredCaption  String   @default("")
  blueprintCaption String   @default("")
  metricsCaption   String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("technical_imageries")
  @@schema("public")
}

model ProjectDatabaseSchema {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  projectId   String
  order       Int      @default(0)
  imageUrl    String   @default("")
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_database_schemas")
  @@schema("public")
}

model ProjectErd {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  projectId   String
  order       Int      @default(0)
  imageUrl    String   @default("")
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_erds")
  @@schema("public")
}

model ResumeDocument {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  title       String
  description String?
  fileType    String   // "pdf" | "md"
  fileName    String   // original filename
  storedName  String   // stored filename on disk
  filePath    String   // relative path on disk
  fileSize    Int      // in bytes
  mimeType    String   // application/pdf or text/markdown
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("resume_documents")
  @@schema("public")
}

// ─── VERSION 2 MODELS ────────────────────────────────────────

model HeroConfigV2 {
  id                 String   @id @default("hero_v2_default")
  name               String   @default("Awaluddin")
  role               String   @default("Backend Engineer & AI Integrator")
  headline           String   @default("Production Systems at Scale")
  quote              String   @default("I ship LLM integrations into production — not train models in notebooks.")
  status             String   @default("available")
  statusText         String   @default("Available for Remote Roles (UTC+7)")
  resumeUrl          String   @default("/assets/resume/Awaluddin_cv.pdf")
  docsUrl            String   @default("https://sb.awaluddin.dev/docs")
  aboutText          String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("hero_config_v2")
  @@schema("public")
}

model MetricV2 {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  value       String
  label       String
  description String
  subtext     String
  icon        String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("metrics_v2")
  @@schema("public")
}

model CareerExperienceV2 {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  company   String
  role      String
  period    String
  isActive  Boolean  @default(false)
  bullets   Json
  techTags  String[]
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("career_experiences_v2")
  @@schema("public")
}

model ProficiencyPillarV2 {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  pillarNumber String
  title        String
  description  String
  icon         String
  skills       Json
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("proficiency_pillars_v2")
  @@schema("public")
}

model ProjectV2 {
  id            String   @id @default(dbgenerated("gen_random_uuid()"))
  title         String
  subtitle      String
  category      String
  date          String
  tags          String[]
  domainBadge   String?
  problem       String?
  solution      String?
  pipelineFlow  String[]
  spineColor    String   @default("#0f4c75")
  coverColor    String   @default("#142028")
  spineText     String   @default("")
  github        String?
  demoUrl       String?
  stats         Json?
  phases        Json?
  markdown      String   @default("")
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("projects_v2")
  @@schema("public")
}
